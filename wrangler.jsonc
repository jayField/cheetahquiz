{
  "name": "cheetahquiz",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "cheetahquiz.com", "custom_domain": true },
    { "pattern": "www.cheetahquiz.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // /quiz/5 로 바로 들어와도 index.html 을 보여준다
    "not_found_handling": "single-page-application"
  }
}
